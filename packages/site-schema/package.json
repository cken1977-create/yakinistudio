{
  "name": "@yakini/site-schema",
  "version": "0.1.0",
  "private": true,
  "description": "SiteDoc zod schema, JSON Schema export, schema migrations and loadSiteDoc (spec 7.1, 7.4).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fixtures/v1/*.json": "./fixtures/v1/*.json",
    "./fixtures/design/*.json": "./fixtures/design/*.json",
    "./fixtures/v2/*.json": "./fixtures/v2/*.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.0",
    "@yakini/pricing": "*"
  },
  "devDependencies": {
    "typescript": "^5",
    "vitest": "^5.1.0",
    "@types/node": "^20"
  }
}
