{
  "name": "yakini-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:yakini": "turbo dev --filter=yakini.digital",
    "dev:template": "turbo dev --filter=template",
    "lint": "turbo lint",
    "dev:chef-jada": "turbo dev --filter=chef-jada",
    "build:chef-jada": "turbo build --filter=chef-jada"
  },
  "devDependencies": {
    "turbo": "latest"
  },
  "packageManager": "npm@10.9.2"
}