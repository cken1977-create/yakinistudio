    "dev:chef-jada": "turbo dev --filter=chef-jada",
    "build:chef-jada": "turbo build --filter=chef-jada",
    "dev:momma-sallys": "turbo dev --filter=momma-sallys",
    "build:momma-sallys": "turbo build --filter=momma-sallys"
  },
  "devDependencies": {
    "turbo": "2.9.18"
  },
  "overrides": {
    "@babel/core": "7.29.13",
    "@xmldom/xmldom": "0.8.15",
    "baseline-browser-mapping": "2.11.35",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "browserslist": "4.28.7",
    "form-data": "4.0.6",
    "js-yaml": "4.3.2",
    "minimatch@10": "11.0.5",
    "qs": "6.17.1",
    "source-map-js": "1.2.2",
    "turbo": "2.9.18",
    "ws": "8.22.2",
    "brace-expansion@1.1.14": "1.1.21",
    "brace-expansion@5.0.5": "5.0.12",
    "minimatch@10.2.5": "11.0.5"
  },
  "packageManager": "npm@10.9.2"
