{
  "name": "yakini-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:yakini": "turbo dev --filter=yakini.digital",
    "dev:template": "turbo dev --filter=template",
