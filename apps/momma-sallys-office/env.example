# Momma Sally's Office. Copy to .env.local for local dev. NEVER commit real values.

# Her own Supabase project (not created yet; see README "Infrastructure").
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Everything ships OFF. Each must be exactly "true" to turn on.
OFFICE_ENABLED=false
OFFICE_SQUARE_SYNC_ENABLED=false
OFFICE_RECEIPTS_ENABLED=false

# Square, SANDBOX ONLY in this build (app id must start with "sandbox-").
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
SQUARE_REDIRECT_URL=https://office.mamasallys.com/api/square/callback
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=https://office.mamasallys.com/api/square/webhook
# 32 random bytes, base64:  openssl rand -base64 32
SQUARE_TOKEN_ENCRYPTION_KEY=
SQUARE_BACKFILL_DAYS=30

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
CRON_SECRET=

# Receipt reader: manual (default, owner types it in) or mock (sample data for testing).
RECEIPT_EXTRACTOR=manual
