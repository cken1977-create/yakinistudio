{
  "name": "builder",
  "version": "0.1.0",
  "private": true,
  "description": "Yakini Builder: studio (studio.yakini.digital) + multi-tenant site renderer.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:rls": "bash supabase/tests/run.sh",
    "test:e2e": "playwright test",
    "check:client-env": "node scripts/check-client-env.mjs",
    "eval": "tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval-generate.ts && tsx --conditions=react-server --tsconfig tsconfig.json scripts/eval-edits.ts",
    "lhci": "lhci autorun --config=lighthouserc.cjs",
    "design:gallery": "DESIGN_GALLERY=1 playwright test tests/e2e/design-gallery.spec.ts --trace off",
    "prebuild": "npm run build:site",
    "predev": "npm run build:site",
    "build:site": "node scripts/build-site-css.mjs && node scripts/build-kit-samples.mjs && node scripts/build-site-renderer.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.17.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "@yakini/abuse": "*",
    "@yakini/ai": "*",
    "@yakini/brand": "*",
    "@yakini/edits": "*",
    "@yakini/kits": "*",
    "@yakini/pricing": "*",
    "@yakini/sections": "*",
    "@yakini/site-schema": "*",
    "@yakini/visits": "*",
    "next": "^16.4.6",
    "posthog-js": "^1.454.5",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
